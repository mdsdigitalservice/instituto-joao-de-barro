{
  // Cloudflare Workers: publica a página "em breve" (pasta em-breve) como site estático.
  // Quando o site completo estiver pronto, trocar pelo build do Next.js.
  "name": "instituto-joao-de-barro",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./em-breve"
  },
  // Domínios personalizados: a Cloudflare cria os registros de DNS e o certificado na publicação.
  "routes": [
    { "pattern": "institutojoaodebarro.org.br", "custom_domain": true },
    { "pattern": "www.institutojoaodebarro.org.br", "custom_domain": true }
  ],
  // Mantém o endereço .workers.dev funcionando.
  "workers_dev": true
}
